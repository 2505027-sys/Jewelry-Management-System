<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jewelry Management System</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f5f2f7;
    color: #333;
}

.sidebar {
    width: 250px;
    height: 100vh;
    background: #301344;
    color: white;
    position: fixed;
    left: 0;
    top: 0;
    padding: 25px 15px;
    overflow-y: auto;
}

.logo {
    text-align: center;
    color: #e7c477;
    font-size: 22px;
    margin-bottom: 30px;
}

.sidebar a {
    display: block;
    padding: 14px;
    color: white;
    text-decoration: none;
    margin: 5px 0;
    border-radius: 7px;
    cursor: pointer;
}

.sidebar a:hover,
.sidebar a.active {
    background: #70418a;
}

.main {
    margin-left: 250px;
    padding: 30px;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
    gap: 15px;
}

header h1 {
    color: #301344;
}

header span {
    color: #777;
}

.page {
    display: none;
}

.page.active {
    display: block;
}

.welcome {
    background: linear-gradient(120deg, #301344, #754a88);
    color: white;
    padding: 35px;
    border-radius: 12px;
    margin-bottom: 25px;
}

.welcome h2 {
    color: #e7c477;
    margin-bottom: 12px;
}

.cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 25px;
}

.card, .panel {
    background: white;
    padding: 22px;
    border-radius: 12px;
    box-shadow: 0 3px 12px #ddd;
    margin-bottom: 22px;
}

.card {
    border-left: 5px solid #b9954c;
}

.card h3 {
    color: #777;
    font-size: 14px;
    margin-bottom: 12px;
}

.card p {
    font-size: 24px;
    font-weight: bold;
    color: #301344;
    overflow-wrap: anywhere;
}

.panel h2 {
    color: #301344;
    margin-bottom: 18px;
}

button {
    background: #54246f;
    color: white;
    border: none;
    padding: 11px 16px;
    border-radius: 6px;
    cursor: pointer;
    margin: 3px;
}

button:hover {
    background: #301344;
}

button.delete {
    background: #c0392b;
}

button.edit {
    background: #b58b37;
}

button.secondary {
    background: #777;
}

input, select, textarea {
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 6px;
    width: 100%;
    margin: 7px 0 15px;
}

label {
    font-weight: bold;
    color: #555;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
    min-width: 600px;
}

th, td {
    padding: 13px;
    text-align: left;
    border-bottom: 1px solid #eee;
}

th {
    background: #301344;
    color: white;
}

tr:hover {
    background: #f8f4fa;
}

.table-wrap {
    overflow-x: auto;
}

.search {
    max-width: 350px;
}

.notice {
    background: #f4e9c9;
    padding: 15px;
    border-radius: 7px;
    margin-bottom: 15px;
}

.empty {
    text-align: center;
    padding: 25px;
    color: #888;
}

.status-low {
    color: #c0392b;
    font-weight: bold;
}

.status-good {
    color: #218c55;
    font-weight: bold;
}

@media(max-width: 1000px) {
    .cards {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media(max-width: 750px) {
    .sidebar {
        width: 100%;
        height: auto;
        position: relative;
    }

    .sidebar a {
        display: inline-block;
        padding: 10px;
    }

    .main {
        margin-left: 0;
        padding: 15px;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }
}

@media(max-width: 500px) {
    .cards {
        grid-template-columns: 1fr;
    }

    header {
        flex-direction: column;
        align-items: flex-start;
    }
}

@media print {
    .sidebar, button, form, .search {
        display: none !important;
    }

    .main {
        margin: 0;
        padding: 0;
    }

    .page {
        display: none !important;
    }

    #reports {
        display: block !important;
    }
}
</style>
</head>

<body>

<div class="sidebar">
    <h2 class="logo">✦ JEWELRY PRO</h2>

    <a class="active" data-page="dashboard">Dashboard</a>
    <a data-page="jewelry">Jewelry Management</a>
    <a data-page="categories">Categories</a>
    <a data-page="stock">Stock Management</a>
    <a data-page="sales">Sales</a>
    <a data-page="customers">Customers</a>
    <a data-page="suppliers">Suppliers</a>
    <a data-page="reports">Reports</a>
    <a data-page="users">Users</a>
</div>

<div class="main">

<header>
    <h1 id="pageTitle">Dashboard</h1>
    <span id="today"></span>
</header>

<!-- DASHBOARD -->

<section id="dashboard" class="page active">

    <div class="welcome">
        <h2>Welcome to Jewelry Management System</h2>
        <p>Manage jewelry products, inventory, customers, suppliers and sales in one place.</p>
    </div>

    <div class="cards">

        <div class="card">
            <h3>Total Jewelry Products</h3>
            <p id="totalJewelry">0</p>
        </div>

        <div class="card">
            <h3>Total Customers</h3>
            <p id="totalCustomers">0</p>
        </div>

        <div class="card">
            <h3>Total Sales</h3>
            <p id="totalSales">KSh 0</p>
        </div>

        <div class="card">
            <h3>Available Stock</h3>
            <p id="totalStock">0</p>
        </div>

    </div>

    <div class="panel">
        <h2>Recent Sales</h2>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Jewelry</th>
                        <th>Quantity</th>
                        <th>Amount</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody id="recentSales"></tbody>
            </table>
        </div>
    </div>

</section>

<!-- JEWELRY MANAGEMENT -->

<section id="jewelry" class="page">

    <div class="panel">
        <h2>Add Jewelry Product</h2>

        <form id="jewelryForm">
            <input type="hidden" id="jewelryId">

            <div class="form-grid">

                <div>
                    <label>Product Name</label>
                    <input id="productName" required placeholder="e.g. Gold Necklace">
                </div>

                <div>
                    <label>Category</label>
                    <select id="productCategory" required></select>
                </div>

                <div>
                    <label>Price (KSh)</label>
                    <input type="number" id="productPrice" min="0.01" step="0.01" required>
                </div>

                <div>
                    <label>Quantity</label>
                    <input type="number" id="productQuantity" min="0" step="1" required>
                </div>

                <div>
                    <label>Material</label>
                    <input id="productMaterial" placeholder="Gold, Silver, Diamond">
                </div>

                <div>
                    <label>Supplier</label>
                    <input id="productSupplier" placeholder="Supplier name">
                </div>

            </div>

            <button type="submit">Save Jewelry</button>
            <button type="reset" class="secondary" id="clearJewelry">Clear</button>
        </form>
    </div>

    <div class="panel">
        <h2>Jewelry Inventory</h2>

        <input class="search" id="jewelrySearch" placeholder="Search jewelry...">

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Material</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="jewelryTable"></tbody>
            </table>
        </div>
    </div>

</section>

<!-- CATEGORIES -->

<section id="categories" class="page">

    <div class="panel">
        <h2>Jewelry Categories</h2>

        <label>New Category</label>
        <input id="newCategory" placeholder="Enter category name">

        <button id="addCategory">Add Category</button>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Number of Products</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="categoryTable"></tbody>
            </table>
        </div>
    </div>

</section>

<!-- STOCK -->

<section id="stock" class="page">

    <div class="panel">
        <h2>Stock Management</h2>

        <p class="notice">Monitor product quantities and identify items that need restocking.</p>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Available Quantity</th>
                        <th>Stock Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="stockTable"></tbody>
            </table>
        </div>
    </div>

</section>

<!-- SALES -->

<section id="sales" class="page">

    <div class="panel">
        <h2>Record New Sale</h2>

        <form id="salesForm">

            <label>Customer Name</label>
            <input id="saleCustomer" required placeholder="Customer name">

            <label>Jewelry Product</label>
            <select id="saleProduct" required>
                <option value="">Select Product</option>
            </select>

            <label>Quantity Sold</label>
            <input type="number" id="saleQuantity" min="1" step="1" required>

            <button type="submit">Record Sale</button>
        </form>
    </div>

    <div class="panel">
        <h2>Sales Records</h2>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Sale ID</th>
                        <th>Customer</th>
                        <th>Product</th>
                        <th>Quantity</th>
                        <th>Total Amount</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody id="salesTable"></tbody>
            </table>
        </div>
    </div>

</section>

<!-- CUSTOMERS -->

<section id="customers" class="page">

    <div class="panel">
        <h2>Register Customer</h2>

        <form id="customerForm">
            <input type="hidden" id="customerId">

            <label>Customer Name</label>
            <input id="customerName" required>

            <label>Phone Number</label>
            <input id="customerPhone" required>

            <label>Email Address</label>
            <input type="email" id="customerEmail">

            <button type="submit">Save Customer</button>
            <button type="reset" class="secondary" id="clearCustomer">Clear</button>
        </form>
    </div>

    <div class="panel">
        <h2>Customer Records</h2>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="customerTable"></tbody>
            </table>
        </div>
    </div>

</section>

<!-- SUPPLIERS -->

<section id="suppliers" class="page">

    <div class="panel">
        <h2>Add Supplier</h2>

        <form id="supplierForm">
            <input type="hidden" id="supplierId">

            <label>Supplier Name</label>
            <input id="supplierName" required>

            <label>Phone Number</label>
            <input id="supplierPhone" required>

            <label>Email</label>
            <input type="email" id="supplierEmail">

            <label>Address</label>
            <input id="supplierAddress">

            <button type="submit">Save Supplier</button>
            <button type="reset" class="secondary" id="clearSupplier">Clear</button>
        </form>
    </div>

    <div class="panel">
        <h2>Supplier Records</h2>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Address</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="supplierTable"></tbody>
            </table>
        </div>
    </div>

</section>

<!-- REPORTS -->

<section id="reports" class="page">

    <div class="panel">
        <h2>Business Reports</h2>

        <div class="cards">

            <div class="card">
                <h3>Total Revenue</h3>
                <p id="reportRevenue">KSh 0</p>
            </div>

            <div class="card">
                <h3>Products</h3>
                <p id="reportProducts">0</p>
            </div>

            <div class="card">
                <h3>Transactions</h3>
                <p id="reportTransactions">0</p>
            </div>

            <div class="card">
                <h3>Low Stock Items</h3>
                <p id="reportLowStock">0</p>
            </div>

        </div>

        <button id="printReport">Print Report</button>
        <button id="downloadReport">Download Sales CSV</button>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Quantity Sold</th>
                        <th>Revenue</th>
                    </tr>
                </thead>
                <tbody id="reportTable"></tbody>
            </table>
        </div>
    </div>

</section>

<!-- USERS -->

<section id="users" class="page">

    <div class="panel">
        <h2>System Users</h2>

        <form id="userForm">

            <label>Username</label>
            <input id="username" required>

            <label>Role</label>
            <select id="userRole">
                <option>Administrator</option>
                <option>Manager</option>
                <option>Sales Staff</option>
            </select>

            <button type="submit">Add User</button>
        </form>
    </div>

    <div class="panel">
        <h2>Registered Users</h2>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="userTable"></tbody>
            </table>
        </div>
    </div>

</section>

</div>

<script>

/* =========================
   DATA STORAGE
========================= */

const $ = id => document.getElementById(id);

function loadData(key, fallback) {
    try {
        const value = localStorage.getItem(key);
        return value === null ? fallback : JSON.parse(value);
    } catch {
        return fallback;
    }
}

let jewelry = loadData("jewelry", []);
let customers = loadData("customers", []);
let suppliers = loadData("suppliers", []);
let sales = loadData("sales", []);
let users = loadData("users", [
    {id: 1, name: "admin", role: "Administrator"}
]);
let categories = loadData("categories", [
    "Rings", "Necklaces", "Bracelets", "Earrings", "Watches", "Other"
]);

function saveData() {
    localStorage.setItem("jewelry", JSON.stringify(jewelry));
    localStorage.setItem("customers", JSON.stringify(customers));
    localStorage.setItem("suppliers", JSON.stringify(suppliers));
    localStorage.setItem("sales", JSON.stringify(sales));
    localStorage.setItem("users", JSON.stringify(users));
    localStorage.setItem("categories", JSON.stringify(categories));
}

function money(amount) {
    return "KSh " + Number(amount).toLocaleString("en-KE", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    });
}

function escapeHTML(value) {
    return String(value ?? "").replace(/[&<>"']/g, char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
    })[char]);
}

function emptyRow(columns, message) {
    return `<tr><td colspan="${columns}" class="empty">${message}</td></tr>`;
}

/* =========================
   NAVIGATION
========================= */

document.querySelectorAll(".sidebar a").forEach(link => {
    link.addEventListener("click", function() {
        document.querySelectorAll(".page").forEach(page => {
            page.classList.remove("active");
        });

        document.querySelectorAll(".sidebar a").forEach(item => {
            item.classList.remove("active");
        });

        $(this.dataset.page).classList.add("active");
        this.classList.add("active");

        $("pageTitle").textContent = this.textContent;
        refresh();
    });
});

$("today").textContent = new Date().toDateString();

/* =========================
   CATEGORY MANAGEMENT
========================= */

function updateCategoryOptions() {
    $("productCategory").innerHTML =
        '<option value="">Select Category</option>' +
        categories.map(category =>
            `<option value="${escapeHTML(category)}">${escapeHTML(category)}</option>`
        ).join("");
}

function renderCategories() {
    $("categoryTable").innerHTML = categories.map(category => {
        const count = jewelry.filter(item => item.category === category).length;

        return `
            <tr>
                <td>${escapeHTML(category)}</td>
                <td>${count}</td>
                <td>
                    <button class="delete" data-action="delete-category"
                    data-name="${escapeHTML(category)}">Delete</button>
                </td>
            </tr>
        `;
    }).join("") || emptyRow(3, "No categories available.");

    updateCategoryOptions();
}

$("addCategory").addEventListener("click", () => {
    const name = $("newCategory").value.trim();

    if (!name) {
        alert("Please enter a category name.");
        return;
    }

    if (categories.some(category =>
        category.toLowerCase() === name.toLowerCase()
    )) {
        alert("This category already exists.");
        return;
    }

    categories.push(name);
    $("newCategory").value = "";

    refresh();
});

function deleteCategory(name) {
    if (jewelry.some(item => item.category === name)) {
        alert("This category has products. Reassign or remove those products first.");
        return;
    }

    if (confirm("Delete this category?")) {
        categories = categories.filter(category => category !== name);
        refresh();
    }
}

/* =========================
   JEWELRY MANAGEMENT
========================= */

$("jewelryForm").addEventListener("submit", function(event) {
    event.preventDefault();

    const id = $("jewelryId").value;

    const item = {
        id: id ? Number(id) : Date.now(),
        name: $("productName").value.trim(),
        category: $("productCategory").value,
        price: Number($("productPrice").value),
        quantity: Number($("productQuantity").value),
        material: $("productMaterial").value.trim(),
        supplier: $("productSupplier").value.trim()
    };

    if (!item.name || !item.category || item.price <= 0 ||
        item.quantity < 0 || !Number.isInteger(item.quantity)) {
        alert("Please enter valid product details.");
        return;
    }

    if (id) {
        jewelry = jewelry.map(product =>
            product.id === Number(id) ? item : product
        );
    } else {
        jewelry.push(item);
    }

    this.reset();
    $("jewelryId").value = "";

    refresh();
    alert("Jewelry product saved successfully!");
});

$("clearJewelry").addEventListener("click", () => {
    $("jewelryId").value = "";
});

function renderJewelry(search = "") {
    const filtered = jewelry.filter(item =>
        item.name.toLowerCase().includes(search.toLowerCase())
    );

    $("jewelryTable").innerHTML = filtered.map(item => `
        <tr>
            <td>${item.id}</td>
            <td>${escapeHTML(item.name)}</td>
            <td>${escapeHTML(item.category)}</td>
            <td>${escapeHTML(item.material)}</td>
            <td>${money(item.price)}</td>
            <td>${item.quantity}</td>
            <td>
                <button class="edit" data-action="edit-jewelry" data-id="${item.id}">Edit</button>
                <button class="delete" data-action="delete-jewelry" data-id="${item.id}">Delete</button>
            </td>
        </tr>
    `).join("") || emptyRow(7, "No jewelry products found.");
}

$("jewelrySearch").addEventListener("input", function() {
    renderJewelry(this.value);
});

function editJewelry(id) {
    const item = jewelry.find(product => product.id === id);
    if (!item) return;

    $("jewelryId").value = item.id;
    $("productName").value = item.name;
    $("productCategory").value = item.category;
    $("productPrice").value = item.price;
    $("productQuantity").value = item.quantity;
    $("productMaterial").value = item.material;
    $("productSupplier").value = item.supplier;

    $("jewelryForm").scrollIntoView({behavior: "smooth"});
}

function deleteJewelry(id) {
    if (!confirm("Delete this jewelry product?")) return;

    jewelry = jewelry.filter(item => item.id !== id);
    refresh();
}

/* =========================
   STOCK MANAGEMENT
========================= */

function renderStock() {
    $("stockTable").innerHTML = jewelry.map(item => `
        <tr>
            <td>${escapeHTML(item.name)}</td>
            <td>${escapeHTML(item.category)}</td>
            <td>${item.quantity}</td>
            <td class="${item.quantity <= 5 ? "status-low" : "status-good"}">
                ${item.quantity <= 5 ? "Low Stock" : "Available"}
            </td>
            <td>
                <button data-action="edit-jewelry" data-id="${item.id}">Update</button>
            </td>
        </tr>
    `).join("") || emptyRow(5, "No stock records available.");
}

/* =========================
   SALES MANAGEMENT
========================= */

function updateProductOptions() {
    $("saleProduct").innerHTML =
        '<option value="">Select Product</option>' +
        jewelry.filter(item => item.quantity > 0).map(item => `
            <option value="${item.id}">
                ${escapeHTML(item.name)} - ${money(item.price)}
                (${item.quantity} available)
            </option>
        `).join("");
}

$("salesForm").addEventListener("submit", function(event) {
    event.preventDefault();

    const productId = Number($("saleProduct").value);
    const quantity = Number($("saleQuantity").value);

    const product = jewelry.find(item => item.id === productId);

    if (!product) {
        alert("Please select a valid product.");
        return;
    }

    if (!Number.isInteger(quantity) || quantity <= 0 ||
        quantity > product.quantity) {
        alert("Insufficient stock. Available quantity: " + product.quantity);
        return;
    }

    const sale = {
        id: Date.now(),
        customer: $("saleCustomer").value.trim(),
        product: product.name,
        productId: product.id,
        quantity: quantity,
        amount: quantity * product.price,
        date: new Date().toLocaleDateString("en-KE")
    };

    product.quantity -= quantity;
    sales.push(sale);

    this.reset();
    refresh();

    alert("Sale recorded successfully!");
});

function renderSales() {
    $("salesTable").innerHTML = sales.map(sale => `
        <tr>
            <td>${sale.id}</td>
            <td>${escapeHTML(sale.customer)}</td>
            <td>${escapeHTML(sale.product)}</td>
            <td>${sale.quantity}</td>
            <td>${money(sale.amount)}</td>
            <td>${escapeHTML(sale.date)}</td>
        </tr>
    `).join("") || emptyRow(6, "No sales recorded.");
}

/* =========================
   CUSTOMER MANAGEMENT
========================= */

$("customerForm").addEventListener("submit", function(event) {
    event.preventDefault();

    const id = $("customerId").value;

    const customer = {
        id: id ? Number(id) : Date.now(),
        name: $("customerName").value.trim(),
        phone: $("customerPhone").value.trim(),
        email: $("customerEmail").value.trim()
    };

    if (id) {
        customers = customers.map(item =>
            item.id === Number(id) ? customer : item
        );
    } else {
        customers.push(customer);
    }

    this.reset();
    $("customerId").value = "";

    refresh();
    alert("Customer saved successfully!");
});

$("clearCustomer").addEventListener("click", () => {
    $("customerId").value = "";
});

function renderCustomers() {
    $("customerTable").innerHTML = customers.map(customer => `
        <tr>
            <td>${customer.id}</td>
            <td>${escapeHTML(customer.name)}</td>
            <td>${escapeHTML(customer.phone)}</td>
            <td>${escapeHTML(customer.email)}</td>
            <td>
                <button class="edit" data-action="edit-customer" data-id="${customer.id}">Edit</button>
                <button class="delete" data-action="delete-customer" data-id="${customer.id}">Delete</button>
            </td>
        </tr>
    `).join("") || emptyRow(5, "No customers registered.");
}

function editCustomer(id) {
    const customer = customers.find(item => item.id === id);
    if (!customer) return;

    $("customerId").value = customer.id;
    $("customerName").value = customer.name;
    $("customerPhone").value = customer.phone;
    $("customerEmail").value = customer.email;

    $("customerForm").scrollIntoView({behavior: "smooth"});
}

function deleteCustomer(id) {
    if (!confirm("Delete this customer?")) return;

    customers = customers.filter(item => item.id !== id);
    refresh();
}

/* =========================
   SUPPLIER MANAGEMENT
========================= */

$("supplierForm").addEventListener("submit", function(event) {
    event.preventDefault();

    const id = $("supplierId").value;

    const supplier = {
        id: id ? Number(id) : Date.now(),
        name: $("supplierName").value.trim(),
        phone: $("supplierPhone").value.trim(),
        email: $("supplierEmail").value.trim(),
        address: $("supplierAddress").value.trim()
    };

    if (id) {
        suppliers = suppliers.map(item =>
            item.id === Number(id) ? supplier : item
        );
    } else {
        suppliers.push(supplier);
    }

    this.reset();
    $("supplierId").value = "";

    refresh();
    alert("Supplier saved successfully!");
});

$("clearSupplier").addEventListener("click", () => {
    $("supplierId").value = "";
});

function renderSuppliers() {
    $("supplierTable").innerHTML = suppliers.map(supplier => `
        <tr>
            <td>${supplier.id}</td>
            <td>${escapeHTML(supplier.name)}</td>
            <td>${escapeHTML(supplier.phone)}</td>
            <td>${escapeHTML(supplier.email)}</td>
            <td>${escapeHTML(supplier.address)}</td>
            <td>
                <button class="edit" data-action="edit-supplier" data-id="${supplier.id}">Edit</button>
                <button class="delete" data-action="delete-supplier" data-id="${supplier.id}">Delete</button>
            </td>
        </tr>
    `).join("") || emptyRow(6, "No suppliers registered.");
}

function editSupplier(id) {
    const supplier = suppliers.find(item => item.id === id);
    if (!supplier) return;

    $("supplierId").value = supplier.id;
    $("supplierName").value = supplier.name;
    $("supplierPhone").value = supplier.phone;
    $("supplierEmail").value = supplier.email;
    $("supplierAddress").value = supplier.address;

    $("supplierForm").scrollIntoView({behavior: "smooth"});
}

function deleteSupplier(id) {
    if (!confirm("Delete this supplier?")) return;

    suppliers = suppliers.filter(item => item.id !== id);
    refresh();
}

/* =========================
   USER MANAGEMENT
========================= */

$("userForm").addEventListener("submit", function(event) {
    event.preventDefault();

    const name = $("username").value.trim();

    if (users.some(user =>
        user.name.toLowerCase() === name.toLowerCase()
    )) {
        alert("This username already exists.");
        return;
    }

    users.push({
        id: Date.now(),
        name: name,
        role: $("userRole").value
    });

    this.reset();
    refresh();

    alert("User added successfully!");
});

function renderUsers() {
    $("userTable").innerHTML = users.map(user => `
        <tr>
            <td>${escapeHTML(user.name)}</td>
            <td>${escapeHTML(user.role)}</td>
            <td>
                ${user.id === 1 ? "Default Administrator" :
                `<button class="delete" data-action="delete-user" data-id="${user.id}">Delete</button>`}
            </td>
        </tr>
    `).join("") || emptyRow(3, "No users registered.");
}

function deleteUser(id) {
    if (!confirm("Delete this user?")) return;

    users = users.filter(user => user.id !== id);
    refresh();
}

/* =========================
   REPORTS
========================= */

function renderReports() {
    const revenue = sales.reduce((total, sale) => total + sale.amount, 0);

    $("reportRevenue").textContent = money(revenue);
    $("reportProducts").textContent = jewelry.length;
    $("reportTransactions").textContent = sales.length;
    $("reportLowStock").textContent =
        jewelry.filter(item => item.quantity <= 5).length;

    const summary = {};

    sales.forEach(sale => {
        if (!summary[sale.product]) {
            summary[sale.product] = {
                quantity: 0,
                revenue: 0
            };
        }

        summary[sale.product].quantity += sale.quantity;
        summary[sale.product].revenue += sale.amount;
    });

    $("reportTable").innerHTML = Object.entries(summary).map(([name, data]) => `
        <tr>
            <td>${escapeHTML(name)}</td>
            <td>${data.quantity}</td>
            <td>${money(data.revenue)}</td>
        </tr>
    `).join("") || emptyRow(3, "No sales data available.");
}

$("printReport").addEventListener("click", () => {
    document.querySelectorAll(".page").forEach(page => {
        page.classList.remove("active");
    });

    $("reports").classList.add("active");
    window.print();

    document.querySelectorAll(".page").forEach(page => {
        page.classList.remove("active");
    });

    const activeLink = document.querySelector(".sidebar a.active");
    $(activeLink ? activeLink.dataset.page : "dashboard").classList.add("active");
});

$("downloadReport").addEventListener("click", () => {
    let csv = "Sale ID,Customer,Product,Quantity,Amount,Date\n";

    sales.forEach(sale => {
        csv += [
            sale.id,
            sale.customer,
            sale.product,
            sale.quantity,
            sale.amount,
            sale.date
        ].map(value =>
            `"${String(value).replace(/"/g, '""')}"`
        ).join(",") + "\n";
    });

    const blob = new Blob([csv], {type: "text/csv;charset=utf-8;"});
    const url = URL.createObjectURL(blob);

    const link = document.createElement("a");
    link.href = url;
    link.download = "Jewelry_Sales_Report.csv";
    link.click();

    URL.revokeObjectURL(url);
});

/* =========================
   DASHBOARD
========================= */

function renderDashboard() {
    $("totalJewelry").textContent = jewelry.length;
    $("totalCustomers").textContent = customers.length;

    const revenue = sales.reduce((total, sale) => total + sale.amount, 0);
    $("totalSales").textContent = money(revenue);

    $("totalStock").textContent = jewelry.reduce(
        (total, item) => total + item.quantity, 0
    );

    $("recentSales").innerHTML = sales.slice(-5).reverse().map(sale => `
        <tr>
            <td>${escapeHTML(sale.customer)}</td>
            <td>${escapeHTML(sale.product)}</td>
            <td>${sale.quantity}</td>
            <td>${money(sale.amount)}</td>
            <td>${escapeHTML(sale.date)}</td>
        </tr>
    `).join("") || emptyRow(5, "No recent sales.");
}

/* =========================
   BUTTON ACTIONS
========================= */

document.addEventListener("click", function(event) {
    const button = event.target.closest("button[data-action]");
    if (!button) return;

    const action = button.dataset.action;
    const id = Number(button.dataset.id);

    switch (action) {
        case "edit-jewelry":
            editJewelry(id);
            break;

        case "delete-jewelry":
            deleteJewelry(id);
            break;

        case "edit-customer":
            editCustomer(id);
            break;

        case "delete-customer":
            deleteCustomer(id);
            break;

        case "edit-supplier":
            editSupplier(id);
            break;

        case "delete-supplier":
            deleteSupplier(id);
            break;

        case "delete-user":
            deleteUser(id);
            break;

        case "delete-category":
            deleteCategory(button.dataset.name);
            break;
    }
});

/* =========================
   REFRESH SYSTEM
========================= */

function refresh() {
    saveData();

    updateCategoryOptions();

    renderDashboard();
    renderJewelry($("jewelrySearch").value);
    renderCategories();
    renderStock();
    renderSales();
    renderCustomers();
    renderSuppliers();
    renderUsers();
    renderReports();

    updateProductOptions();
}

/* START SYSTEM */

refresh();

</script>

